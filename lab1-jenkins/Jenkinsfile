// ============================================================
// Jenkinsfile — LAB 1 : Pipeline de sécurité automatisé
// Cible : OWASP Juice Shop (local, isolé)
// SCM   : https://github.com/devmail0561-web/labs_sec_data
// ============================================================

pipeline {

    agent any

    environment {
        JUICE_SHOP_URL = "http://juiceshop:3000"
        REPORT_DIR     = "/tmp/reports_${BUILD_NUMBER}"
        NOTIFY_EMAIL   = '$DEFAULT_RECIPIENTS'
        REPO_URL       = "https://github.com/devmail0561-web/labs_sec_data"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    // ── Déclencheurs ──────────────────────────────────────────
    // pollSCM  : Jenkins interroge le dépôt toutes les 5 min
    // githubPush : déclenchement immédiat via webhook GitHub
    //   → Configurer dans GitHub : Settings > Webhooks
    //   → Payload URL : http://<IP_JENKINS>:8080/github-webhook/
    //   → Content type : application/json
    //   → Event       : Just the push event
    triggers {
        pollSCM('H/5 * * * *')
        githubPush()
    }

    stages {

        stage('Préparation') {
            steps {
                echo "============================================================"
                echo " LAB 1 — Pipeline de sécurité OWASP Juice Shop"
                echo " Build #${env.BUILD_NUMBER} — ${new Date()}"
                echo "============================================================"
                sh '''
                    mkdir -p "${REPORT_DIR}/evidence"
                    echo "[OK] Scripts prêts"
                    ls -la /lab/scripts/
                '''
            }
        }

        stage('Vérification cible') {
            steps {
                script {
                    def maxAttempts = 12
                    def attempt    = 0
                    def ready      = false
                    while (attempt < maxAttempts && !ready) {
                        def code = sh(
                            script: "curl -s -o /dev/null -w '%{http_code}' --connect-timeout 5 '${env.JUICE_SHOP_URL}' 2>/dev/null || echo '000'",
                            returnStdout: true
                        ).trim()
                        if (code == '200') {
                            echo "[OK] Juice Shop disponible (HTTP ${code})"
                            ready = true
                        } else {
                            echo "[WAIT] HTTP ${code} — Tentative ${attempt + 1}/${maxAttempts}"
                            sleep(5)
                            attempt++
                        }
                    }
                    if (!ready) error("[ERREUR] Juice Shop inaccessible.")
                }
            }
        }

        stage('TEST 01 — Disponibilité HTTP') {
            steps {
                sh '/lab/scripts/test_http.sh'
            }
            post {
                failure { echo "[FAIL] TEST 01 — Endpoints HTTP non conformes" }
                success { echo "[OK]   TEST 01 — Tous les endpoints répondent" }
            }
        }

        stage('TEST 02 — En-têtes de sécurité') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '/lab/scripts/test_headers.sh'
                }
            }
        }

        stage('TEST 03 — Méthodes HTTP') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '/lab/scripts/test_methods.sh'
                }
            }
        }

        stage('TEST 04 — Authentification') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '/lab/scripts/test_auth.sh'
                }
            }
        }

        stage('TEST 05 — Exposition APIs') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '/lab/scripts/test_api_security.sh'
                }
            }
        }

        stage('TEST 06 — Exploitation') {
            steps {
                echo "--- Phase d'exploitation : SQLi→JWT / IDOR / FTP / XSS ---"
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '/lab/scripts/test_exploitation.sh'
                }
            }
            post {
                always {
                    echo "[INFO] Preuves d'exploitation dans : ${REPORT_DIR}/evidence/"
                }
            }
        }

        stage('Rapport consolidé') {
            steps {
                sh '/lab/scripts/generate_report.sh'
            }
        }

        stage('Archivage') {
            steps {
                sh '''
                    mkdir -p "${WORKSPACE}/reports"
                    cp "${REPORT_DIR}"/*.txt "${WORKSPACE}/reports/" 2>/dev/null || true
                    cp -r "${REPORT_DIR}/evidence" "${WORKSPACE}/reports/" 2>/dev/null || true
                    echo "[OK] Artefacts copiés"
                    ls -la "${WORKSPACE}/reports/"
                '''
                archiveArtifacts(
                    artifacts: 'reports/**/*',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }
    }

    post {
        always {
            echo "============================================================"
            echo " FIN — Build #${env.BUILD_NUMBER} — Statut : ${currentBuild.currentResult}"
            echo "============================================================"

            // ── Notification email — résultats du pipeline ──────────────
            emailext(
                to:      "${env.NOTIFY_EMAIL}",
                subject: "[Jenkins LAB1] Build #${env.BUILD_NUMBER} — ${currentBuild.currentResult} — Juice Shop Security",
                mimeType: 'text/html',
                body: """
<html><body style="font-family:sans-serif;font-size:14px;">
<h2 style="color:#1a3a5c;">LAB 1 — Pipeline de sécurité OWASP Juice Shop</h2>
<table style="border-collapse:collapse;width:100%;max-width:600px;">
  <tr><td style="padding:6px 12px;background:#f1f5f9;font-weight:bold;">Build</td>
      <td style="padding:6px 12px;">#${env.BUILD_NUMBER}</td></tr>
  <tr><td style="padding:6px 12px;background:#f1f5f9;font-weight:bold;">Statut</td>
      <td style="padding:6px 12px;font-weight:bold;color:${currentBuild.currentResult == 'SUCCESS' ? '#198754' : currentBuild.currentResult == 'UNSTABLE' ? '#fd7e14' : '#dc3545'};">
          ${currentBuild.currentResult}</td></tr>
  <tr><td style="padding:6px 12px;background:#f1f5f9;font-weight:bold;">Durée</td>
      <td style="padding:6px 12px;">${currentBuild.durationString}</td></tr>
  <tr><td style="padding:6px 12px;background:#f1f5f9;font-weight:bold;">Dépôt</td>
      <td style="padding:6px 12px;"><a href="${env.REPO_URL}">${env.REPO_URL}</a></td></tr>
  <tr><td style="padding:6px 12px;background:#f1f5f9;font-weight:bold;">Commit</td>
      <td style="padding:6px 12px;">${env.GIT_COMMIT ?: 'n/a'}</td></tr>
  <tr><td style="padding:6px 12px;background:#f1f5f9;font-weight:bold;">Branche</td>
      <td style="padding:6px 12px;">${env.GIT_BRANCH ?: 'n/a'}</td></tr>
  <tr><td style="padding:6px 12px;background:#f1f5f9;font-weight:bold;">Console</td>
      <td style="padding:6px 12px;"><a href="${env.BUILD_URL}console">Voir les logs</a></td></tr>
  <tr><td style="padding:6px 12px;background:#f1f5f9;font-weight:bold;">Artefacts</td>
      <td style="padding:6px 12px;"><a href="${env.BUILD_URL}artifact/">Télécharger les rapports</a></td></tr>
</table>
<br>
<p style="color:#6c757d;font-size:12px;">
  UNSTABLE = vulnérabilités détectées (comportement attendu sur Juice Shop).<br>
  FAILURE = erreur critique du pipeline (cible inaccessible ou script cassé).
</p>
</body></html>
                """,
                attachLog: false,
                compressLog: false
            )
        }
        success  { echo "[SUCCESS]  Tous les tests passés." }
        unstable { echo "[UNSTABLE] Vulnérabilités détectées et documentées." }
        failure  { echo "[FAILURE]  Erreur critique — vérifier la cible." }
        cleanup  { sh 'rm -rf "${REPORT_DIR}" 2>/dev/null || true' }
    }
}
